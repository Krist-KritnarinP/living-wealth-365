# ==========================================
# Strict Security & Privacy Ignore Rules
# ==========================================

# Dependencies
node_modules/
*/node_modules/

# Environment files & Secrets (Strict: Never commit actual credentials)
.env
.env.*
!.env.example
*.env
*/*.env
*/*.env.*
!*/*.env.example
*.pem
*.key
*.cert
*.crt
id_rsa*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build artifacts & Output
dist/
dist-ssr/
build/
*/dist/
*/build/
uploads/
*/uploads/
!*/uploads/.gitkeep

# Test reports & artifacts
test-results/
playwright-report/
*/test-results/
*/playwright-report/
coverage/
*/coverage/

# Database files
*.db
*.db-journal
*.sqlite
*.sqlite3
*/dev.db
*/dev.db-journal

# OS & Editor files
.DS_Store
*/.DS_Store
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
