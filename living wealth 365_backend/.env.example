# ==========================================
# 🌐 Living Wealth 365 Backend Environment Variables
# ==========================================

# Server Port & Mode
PORT=5001
NODE_ENV=development

# 🗄️ MySQL Database Connection (Local MySQL Workbench)
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>
# Service: Mysql@localhost:3306 | User: root
DATABASE_URL="mysql://root:YOUR_PASSWORD_HERE@localhost:3306/living_wealth_365"

# 🔐 JWT Authentication (ความยาวอย่างน้อย 10 ตัวอักษรขึ้นไป)
JWT_SECRET="livingwealth365_secret_key_change_me_here"
JWT_EXPIRES_IN="7d"

# 🛡️ Frontend Client Origin for CORS
CORS_ORIGIN="http://localhost:5173"
