# ==========================================
# 🌐 Living Wealth 365 Backend Environment Variables
# ==========================================

# Server Port & Mode
PORT=5001
NODE_ENV=development

# 🗄️ Supabase PostgreSQL Database Connections
# 1. Transaction Pooler (Port 6543 / PgBouncer) for Prisma Client runtime
DATABASE_URL="postgresql://postgres.hpdmkvmjesbpufstvvlv:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Session Pooler (Port 5432 / Direct) for Prisma CLI migrations & db push
DIRECT_URL="postgresql://postgres.hpdmkvmjesbpufstvvlv:[YOUR-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# 🔐 JWT Authentication (ความยาวอย่างน้อย 10 ตัวอักษรขึ้นไป)
JWT_SECRET="livingwealth365_secret_key_change_me_here"
JWT_EXPIRES_IN="7d"

# 🛡️ Frontend Client Origin for CORS
CORS_ORIGIN="http://localhost:5173"
