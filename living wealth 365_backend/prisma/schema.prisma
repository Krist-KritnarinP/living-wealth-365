// ==========================================
// ⚙️ Prisma Configuration
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // เปลี่ยนเป็น "mysql" ได้หากโฮสต์ของคุณใช้ MySQL
  url      = env("DATABASE_URL")
}

// ==========================================
// 📌 Enum Definitions
// ==========================================
enum Role {
  CUSTOMER // ลูกค้าทั่วไปที่สมัครสมาชิก
  ADMIN    // ผู้ดูแลระบบ / ที่ปรึกษา
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
  CANCELLED
}

// ==========================================
// 🗄️ Models
// ==========================================

// 1. ผู้ใช้งาน (รองรับทั้ง Admin และ Customer)
model User {
  id          String     @id @default(uuid())
  email       String     @unique
  password    String     // ต้องเข้ารหัส (เช่น bcrypt) ก่อนบันทึกลงฐานข้อมูล
  name        String
  phone       String?    // เบอร์โทร (ใช้ Auto-fill ในฟอร์ม Lead ได้)
  birthDate   DateTime?  // สำหรับใช้คำนวณหินมงคลเฉพาะบุคคล (สายมู)
  role        Role       @default(CUSTOMER)
  
  // Relations
  leads       Lead[]     // ประวัติการส่งฟอร์มขอคำปรึกษา
  posts       Post[]     // บทความที่เขียน (สำหรับ Admin)
  wishlists   Wishlist[] // สินค้าสายมูที่กดบันทึกไว้ดูภายหลัง
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// 2. ข้อมูลติดต่อกลับ (Lead Capture)
model Lead {
  id            String     @id @default(uuid())
  
  // ข้อมูลฟอร์ม (บังคับกรอก เพื่อรองรับลูกค้าที่ไม่ได้ Login)
  name          String
  phone         String
  interest      String     
  preferredTime String?    
  status        LeadStatus @default(NEW)
  notes         String?    @db.Text 

  // ความสัมพันธ์กับ User (Optional เพื่อให้ลูกค้าขาจรกรอกได้)
  // หาก User ลบบัญชี (SetNull) ข้อมูล Lead จะยังอยู่แต่ไม่ผูกกับบัญชีแล้ว
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// 3. บทความความรู้ (Blog)
model Post {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String   @db.Text
  excerpt     String?  
  imageUrl    String?  
  published   Boolean  @default(false)
  
  // ลิงก์ไปยังผู้เขียนบทความ
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 4. สินค้าสายมู / วัตถุมงคล (Mu-Tae-Lu)
model Product {
  id           String     @id @default(uuid())
  name         String
  description  String     @db.Text
  imageUrl     String?
  isActive     Boolean    @default(true) 
  
  // Relations
  wishlistedBy Wishlist[]
  
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// 5. ระบบบันทึกสิ่งที่สนใจ (Wishlist) สำหรับสมาชิก
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  
  // หากลบ User หรือ Product ข้อมูลใน Wishlist จะถูกลบตามไปด้วย (Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // ป้องกันไม่ให้ User กด Favorite สินค้าชิ้นเดิมซ้ำซ้อน
  @@unique([userId, productId]) 
}
