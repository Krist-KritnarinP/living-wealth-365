// ==========================================
// ⚙️ Prisma Configuration for Living Wealth 365
// ==========================================
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql" // Supabase PostgreSQL
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 📌 Enum Definitions
// ==========================================
enum Role {
  CUSTOMER // ลูกค้าทั่วไปที่สมัครสมาชิก
  ADMIN    // ผู้ดูแลระบบ / ที่ปรึกษา
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
  CANCELLED
}

// 🏛️ 7 เสาหลักของ Living Wealth 365
enum ContentPillar {
  LIFE           // 1. Life Planning, Purpose, Lifestyle, Living after Retirement
  WEALTH         // 2. Financial, Protection, Investment, Tax, Retirement, Legacy
  WELLBEING      // 3. Healthspan, Nutrition, Sleep, Mental Health, Mindfulness
  INNER_LIFE     // 4. Philosophy, Buddhism, Consciousness, Meditation
  EARTH_ENERGY   // 5. Minerals, Crystals, Chakras, Traditions
  JOURNAL        // 6. Explore & Journal, Books, Tech, Longevity, Travel
  ABOUT          // 7. Philosophy, Top & Joy
}

// ✍️ รูปแบบเนื้อหา
enum PostType {
  ARTICLE        // บทความวิชาการ / บทความยาว
  TOPS_NOTES     // 🌟 บันทึกความคิดของ Top (Top's Notes)
  JOURNEY        // 🌟 เรื่องราวการเดินทางและการทดลองของ Top & Joy
  EXPLORING      // สิ่งที่กำลังค้นคว้า / รีวิวหนังสือ / Longevity
}

// 💎 มิติของแร่ธาตุและคริสตัล (Earth & Energy)
enum EarthAspect {
  SCIENCE        // วิทยาศาสตร์, ธรณีวิทยา, โครงสร้างแร่
  HISTORY        // ประวัติศาสตร์และแหล่งกำเนิด
  CULTURE        // วัฒนธรรมและประเพณีความเชื่อโบราณ
  CHAKRA_ENERGY  // พลังงานจักระและการเจริญสติ (Mindfulness)
  PERSONAL_EXP   // บันทึกการทดลองส่วนตัว
}

// ==========================================
// 🗄️ Models
// ==========================================

// 1. ผู้ใช้งาน (รองรับทั้ง Admin และ Customer)
model User {
  id          String     @id @default(uuid())
  username    String     @unique // ชื่อผู้ใช้ในระบบ
  email       String     @unique // อีเมลสำหรับติดต่อและเข้าสู่ระบบ
  password    String     // รหัสผ่านเข้ารหัส bcrypt (มาตรฐานเริ่มต้น 8 ตัวอักษร)
  name        String     // ชื่อ-นามสกุล
  phone       String?    // เบอร์โทรศัพท์ 9-10 หลัก
  birthDate   DateTime?  // วันเกิด (สำหรับคำนวณหินมงคลประจำตัว)
  role        Role       @default(CUSTOMER)
  
  // Relations
  leads       Lead[]     // ประวัติการส่งฟอร์มขอคำปรึกษา
  posts       Post[]     // บทความที่เขียน (สำหรับ Admin)
  wishlists   Wishlist[] // สินค้าสายมูที่บันทึกไว้ใน Wishlist
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("users")
}

// 2. ข้อมูลติดต่อกลับ (Lead Capture & Let's Talk)
model Lead {
  id            String     @id @default(uuid())
  name          String     // ชื่อลูกค้าสำหรับติดต่อ
  phone         String     // เบอร์โทรศัพท์
  interest      String     // บริการหรือหัวข้อที่สนใจ (เช่น วางแผนชีวิต, ภาษี, ประกัน, พูดคุยกับ Top & Joy)
  preferredTime String?    // ช่วงเวลาที่สะดวกรับสาย
  status        LeadStatus @default(NEW)
  notes         String?    @db.Text // บันทึกจากลูกค้าหรือที่ปรึกษา

  // ความสัมพันธ์กับ User (Optional รองรับลูกค้าทั่วไปที่ไม่ได้ Login)
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("leads")
}

// 3. บทความ & วารสาร (Explore, Journal & Knowledge Hub)
model Post {
  id          String        @id @default(uuid())
  title       String        @db.VarChar(255)
  slug        String        @unique
  content     String        @db.Text
  excerpt     String?       @db.Text
  imageUrl    String?       @db.Text
  category    String        @default("การวางแผนการเงิน")
  pillar      ContentPillar @default(JOURNAL) // 🏛️ จัดอยู่ใน 7 เสาหลัก
  postType    PostType      @default(ARTICLE) // ✍️ บทความ / Top's Notes / Journey
  authorName  String        @default("Top & Joy") // 👤 ผู้เขียน: Top, Joy, หรือ Top & Joy
  readTime    String?       @default("5 นาที")
  tags        String?       // #Tax, #Longevity, #Mindfulness
  published   Boolean       @default(false)
  
  // ลิงก์ไปยัง User ในระบบ
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("posts")
}

// 4. แร่ธาตุ คริสตัล และพลังงานธรรมชาติ (Earth & Energy Curation)
model Product {
  id             String       @id @default(uuid())
  name           String
  category       String?
  price          Decimal?     @db.Decimal(10, 2)
  description    String       @db.Text
  imageUrl       String?      @db.Text
  stoneType      String?      // ชนิดของแร่หรือคริสตัล เช่น ไทเกอร์อาย, ลาพิส ลาซูลี, มาลาไคต์
  dayOfWeek      String?      // วันในสัปดาห์ที่สัมพันธ์
  aspect         EarthAspect  @default(CHAKRA_ENERGY) // 💎 มิติของชิ้นงาน: วิทย์ / ประวัติศาสตร์ / วัฒนธรรม / จักระ
  chakra         String?      // จักระที่สอดคล้อง เช่น จักระ 4 (หัวใจ), จักระ 6 (ตาที่สาม)
  mineralFormula String?      // สูตรโครงสร้างแร่ทางเคมี เช่น SiO2, Cu2CO3(OH)2
  isCurated      Boolean      @default(true) // ชิ้นงานคัดสรรพิเศษโดย Top & Joy
  isActive       Boolean      @default(true)
  
  // Relations
  wishlistedBy   Wishlist[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("products")
}

// 5. ระบบบันทึกสิ่งที่สนใจ (Wishlist) สำหรับสมาชิก
model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // ป้องกันการบันทึกชิ้นเดิมซ้ำ
  @@unique([userId, productId])
  @@map("wishlists")
}

// 6. แผนประกันภัยและการเงิน (Insurance Plans CMS & Comparison)
model InsurancePlan {
  id             String   @id @default(uuid())
  type           String   // 'LIFE' (ชีวิต/สุขภาพ/โรคร้าย/เกษียณ) หรือ 'NON_LIFE' (รถ/บ้าน/ธุรกิจ/PA)
  category       String   // เช่น 'HEALTH', 'CRITICAL_ILLNESS', 'RETIREMENT', 'TAX', 'MOTOR', 'PROPERTY', 'PA'
  categoryName   String   // เช่น 'ประกันสุขภาพเหมาจ่าย', 'คุ้มครองโรคร้ายแรง', 'วางแผนบำนาญ'
  name           String   // ชื่อแผนประกัน เช่น 'AIA Health Happy', 'AIA Multi-Pay CI'
  slug           String   @unique
  tagline        String?  // คำโปรย เช่น 'เหมาจ่ายค่ารักษาพยาบาลสูงสุด 25 ล้านบาท/รอบปีกรมธรรม์'
  coverageAmount String?  // เช่น 'สูงสุด 25,000,000 บาท'
  startingPrice  String?  // เช่น 'เริ่มต้น 1,850 บ./เดือน'
  features       String   @db.Text // จุดเด่นความคุ้มครอง (เก็บเป็น JSON string หรือรายการคั่นด้วย newline)
  recommendedFor String?  // เช่น 'คนวัยทำงาน, ผู้ที่ต้องการคุ้มครองค่ารักษาพยาบาล รพ.เอกชน'
  description    String   @db.Text // รายละเอียดเชิงลึกและเงื่อนไข
  imageUrl       String?  @db.Text
  brochureUrl    String?  @db.Text
  isActive       Boolean  @default(true) // แอดมินสามารถเปิด/ปิด หรือยกเลิกแผนได้
  sortOrder      Int      @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("insurance_plans")
}
